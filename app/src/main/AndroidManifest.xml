<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Needed so we can see/launch installed emulators (Android 11+) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.valvesoftware.steamlink" />
        <package android:name="app.gamenative" />
        <package android:name="com.winlator" />
        <package android:name="com.winlator.cmod" />
        <package android:name="io.github.yazanj082.momiji" />
        <package android:name="com.playstation.remoteplay" />
        <package android:name="aenu.ax360e" />
        <package android:name="aenu.ax360e.free" />
        <package android:name="xyz.aethersx2.android" />
        <package android:name="org.dolphinemu.dolphinemu" />
        <package android:name="org.ppsspp.ppsspp" />
        <package android:name="org.azahar_emu.azahar" />
        <package android:name="com.github.stenzek.duckstation" />
    </queries>
    <application android:label="Synapse Gaming" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher" android:largeHeap="true" android:theme="@style/Theme.Synapse">
        <activity android:name=".PlayerActivity" android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|smallestScreenSize|screenLayout|uiMode"
            android:theme="@style/Theme.Synapse" />
        <activity android:name=".CloudActivity" android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|smallestScreenSize|screenLayout|uiMode"
            android:hardwareAccelerated="true"
            android:theme="@style/Theme.Synapse" />
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
