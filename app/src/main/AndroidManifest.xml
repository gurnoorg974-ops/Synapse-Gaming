<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Needed so we can see/launch installed emulators (Android 11+) -->
    <queries>
        <package android:name="aenu.ax360e" />
        <package android:name="xyz.aethersx2.android" />
        <package android:name="org.dolphinemu.dolphinemu" />
        <package android:name="org.ppsspp.ppsspp" />
        <package android:name="org.azahar_emu.azahar" />
        <package android:name="com.github.stenzek.duckstation" />
    </queries>
    <application android:label="Synapse Gaming" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher" android:theme="@style/Theme.Synapse">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
